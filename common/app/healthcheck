#!/bin/sh
# Unhealthy if the last scheduled job failed. Healthy before any job has run. A hung job
# shows up when the next one fails because GYB is already running.
last=$CONFIG_DIR/.last-run
[ -f "$last" ] || exit 0
read -r rc when < "$last"
[ "$rc" = 0 ] && exit 0
echo "The last GYB job failed, with exit code $rc, at $(date -d "@$when" +%FT%T%z)"
exit 1

#!/usr/bin/with-contenv bash
exec &>> >(tee -a /var/log/init-gyb)

echo "[Config] Starting GYB Config..."

# Folders and the log file created here get the same umask as GYB's own files
umask "${UMASK:-077}"

# Block Short URLs?
if [ -n "${NOSHORTURLS}" ]; then
  echo "[Config] Blocking GYB short urls"
  echo "127.0.0.1  gyb-shortn.jaylee.us" >> /etc/hosts
fi

# Backwards compatibility
if [ -n "${DEST}" ]; then
  DEST_DIR=$DEST
fi

# Create directory structure
echo "[Config] Ensuring '$CONFIG_DIR' and '$DEST_DIR' exist"
mkdir -p $CONFIG_DIR
mkdir -p $DEST_DIR

# Fix permissions
lsiown -R abc:abc \
  /app \
  $CONFIG_DIR \
  $DEST_DIR
chmod +x /app/*

# Send mail on cron error? (/app/job sends it)
if [ -n "${MAIL_FROM}" ] && [ -n "${MAIL_TO}" ]; then
  echo "[Config] Sending mail to ${MAIL_TO} on cron errors"
fi

# Log to file? (/app/job writes and rotates it)
if [ -n "${LOG_FILE}" ]; then
  echo "[Config] Logging app runs to ${LOG_FILE} as well"
  # If we create the folder, give it to abc so the job can rotate the log. Leave an
  # existing folder alone.
  [ -d "${LOG_FILE%/*}" ] || { mkdir -p "${LOG_FILE%/*}" && lsiown abc:abc "${LOG_FILE%/*}"; }
  touch "${LOG_FILE}" && lsiown abc:abc "${LOG_FILE}"
fi

# Set cron schedule. Jobs run through /app/job, which handles logging, the health check
# and failure mail. Cron doesn't pass on the container's env, so with-contenv does.
: > /etc/crontabs/abc
for job in FULL INC EXTRA; do
  cron_var="JOB_${job}_CRON" cmd_var="JOB_${job}_CMD"
  if [ -n "${!cmd_var}" ] && [ -n "${!cron_var}" ]; then
    echo "${!cron_var} /usr/bin/with-contenv /app/job ${!cmd_var}" >> /etc/crontabs/abc
  fi
done

# No real point in running root crontab
crontab -r root

echo "[Config] GYB Config Complete"
